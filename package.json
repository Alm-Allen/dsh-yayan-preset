{
  "name": "@alm-allen/dsh-yayan-preset",
  "version": "2026.10.12",
  "description": "雅言模式（yayan）：把 DeepSeek Harness 的原生 standard 预设汉化——按 Loader 行 id 覆盖它的插件列表以加入中文化层，不新增预设条目。",
  "type": "module",
  "license": "MIT",
  "main": "./plugins/yayan-zh.mjs",
  "exports": {
    ".": "./plugins/yayan-zh.mjs",
    "./yayan-zh": "./plugins/yayan-zh.mjs",
    "./append-entries": "./plugins/append-entries.mjs",
    "./self-test": "./plugins/self-test.mjs",
    "./audit-coverage": "./plugins/audit-coverage.mjs",
    "./audit-runtime-tools": "./plugins/audit-runtime-tools.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "plugins",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alm-Allen/dsh-yayan-preset.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agent-preset",
    "yayan"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
